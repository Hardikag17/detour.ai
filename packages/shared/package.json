{
  "name": "@detour/shared",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./generated/*": "./src/generated/*.ts"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@parcel/watcher": "^2.6.0",
    "graphql": "^16.10.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "dev": "graphql-codegen --config codegen.ts --watch",
    "codegen": "graphql-codegen --config codegen.ts"
  }
}
